# LAN entrypoint. Authelia login wall via forward-auth; app itself has no auth code.
{
	auto_https off
}

:80 {
	# Authelia portal (login page) served directly
	handle /authelia* {
		reverse_proxy authelia:9091
	}

	# OPDS token exemption: e-readers can't log in. Long per-device token
	# in the URL; humans still go through the wall. (Task 4/8 own the check.)
	handle /api/v1/opds* {
		reverse_proxy backend:8000
	}

	# Everything else: must pass the login wall first
	handle {
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		reverse_proxy backend:8000
	}
}
# NOTE: no :443 block — plain-LAN install, no domain/cert (dead listener removed).
