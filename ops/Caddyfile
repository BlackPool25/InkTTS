# Global options must come first.
{
	auto_https ignore_loaded_certs
	# Browsers/curl omit SNI for IP literals (RFC 6066) — without this,
	# IP handshakes die with a TLS internal-error alert (no cert selectable).
	default_sni 192.168.29.101
}

# Plain-HTTP twin for the compose `remote` profile (in-container Tailscale
# terminates trusted TLS for the MagicDNS name and forwards here):
#   docker compose --profile remote up -d
# NOTE: enabling `remote` also requires flipping Authelia's cookie domain +
# authelia_url/redirection to the ts.net origin (validator: https + parent
# domain shared by app+portal). See ops/BOOT_CHECK.md "Tailscale remote".
:80 {
	handle /api/v1/opds* {
		reverse_proxy backend:8000
	}
	handle {
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		reverse_proxy backend:8000
	}
}

# LAN entrypoint over HTTPS (Caddy `tls internal` local CA).
# Why https: Authelia 4.39 REQUIRES secure-scheme authelia_url +
# default_redirection_url (validator rejects http) — plain-http LAN + login
# wall is officially unsupported. nip.io names resolve to the LAN IP with
# zero DNS setup; `*.192-168-29-101.nip.io` all -> 192.168.29.101.
# One-time per device: install ops/lan-ca.crt (extracted from Caddy) so the
# local CA is trusted. If DHCP changes the host IP, replace all three
# occurrences of 192-168-29-101 below + the Authelia cookie URLs.
# (Global options block moved to top of file — Caddy requires it first.)

# App: plain LAN IP first (validator accepts IPs; browsers store host-only),
# nip.io names as fallback (same LAN IP, dotted for picky cookie jars).
https://192.168.29.101:8085, https://inkcast.192-168-29-101.nip.io:8085 {
	tls /etc/caddy/certs/lan.crt /etc/caddy/certs/lan.key
	# API + WS: behind the wall (OPDS token-exempt for e-readers)
	handle /api/v1/opds* {
		reverse_proxy backend:8000
	}
	handle /api/* {
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		reverse_proxy backend:8000
	}
	# Reader UI: static PWA, no wall check here (API calls carry the session)
	handle {
		root * /srv/pwa
		try_files {http.request.uri.path} /index.html
		file_server
	}
}

# Portal: same pair, direct (never behind the wall itself).
https://192.168.29.101:8443, https://auth.192-168-29-101.nip.io:8085 {
	tls /etc/caddy/certs/lan.crt /etc/caddy/certs/lan.key
	reverse_proxy authelia:9091
}
