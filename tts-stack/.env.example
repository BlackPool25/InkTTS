# Copy to .env and edit. Only ORCH_PORT is LAN-visible (orchestrator
# service joins this compose in plan Task 4 and binds 0.0.0.0:${ORCH_PORT}).
KOKORO_TAG=v0.10.0
ORCH_PORT=8095
HF_TOKEN= # needed for gated Chatterbox weight downloads; empty otherwise
EVICT_IDLE_MIN=10 # Chatterbox idle-evict lease (orchestrator enforced)
CACHE_CAP_GB=5
