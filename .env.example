# Copy to .env and fill in. API_TOKEN + Authelia secrets are REQUIRED (fail-closed).
# LAN access is https://inkcast.<dash-ip>.nip.io:8085 (Caddy tls internal;
# install ops/lan-ca.crt on each device once). Authelia cookie domain must be
# the parent: <dash-ip>.nip.io (validator rejects empty/IP-less domains).
API_TOKEN=change-me-to-a-long-random-token
AUTHELIA_JWT_SECRET=change-me-32-chars-min
AUTHELIA_SESSION_SECRET=change-me-32-chars-min
AUTHELIA_STORAGE_ENCRYPTION_KEY=change-me-32-chars-min
# Optional remote access only. Leave empty = LAN-only turn-up.
TS_AUTHKEY=
# Cookie/session domain (parent of app+portal nip.io names) and LAN URL.
# If DHCP changes the host IP, update these + Caddyfile + authelia-config.yml.
LAN_HOST=192-168-29-101.nip.io
LAN_URL=https://inkcast.192-168-29-101.nip.io:8085
