# Copy to .env and fill in. API_TOKEN + Authelia secrets are REQUIRED (fail-closed).
API_TOKEN=change-me-to-a-long-random-token
AUTHELIA_JWT_SECRET=change-me-32-chars-min
AUTHELIA_SESSION_SECRET=change-me-32-chars-min
AUTHELIA_STORAGE_ENCRYPTION_KEY=change-me-32-chars-min
# Optional remote access only. Leave empty = LAN-only turn-up.
TS_AUTHKEY=
